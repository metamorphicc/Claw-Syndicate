{
  "name": "claw-syndicate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && npm run check:relay && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "dev:api": "node --env-file-if-exists=.env.api --import tsx --watch server/index.ts",
    "start:api": "node --env-file-if-exists=.env.api --import tsx server/index.ts",
    "admin": "node --env-file-if-exists=.env.api --import tsx server/admin.ts",
    "backup": "node --env-file-if-exists=.env.api --import tsx server/backup-cli.ts",
    "check:relay": "tsc -p tsconfig.vercel.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
